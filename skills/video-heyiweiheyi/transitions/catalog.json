    },
    {
      "id": "ghost-double-exposure",
      "display_name": "电影感若隐若现",
      "suggested_position": "",
      "summary": "画中画叠轨三关键帧（0%→50%→0%）双重曝光浮影：在主画面上缓缓浮现第二段半透明画面并柔和消散，营造强烈电影氛围与记忆重叠感。",
      "supported_aspects": ["16:9", "9:16", "1:1"],
